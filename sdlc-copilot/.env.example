# --- OpenAI / AI service ---
# Leave empty to run in deterministic mock mode (still demo-able end-to-end).
OPENAI_API_KEY=

# Recommended default. Any OpenAI-compatible chat model that supports
# response_format={"type":"json_object"} will work (e.g. gpt-4o, gpt-4-turbo,
# or an Azure deployment that aliases one of these).
OPENAI_MODEL=gpt-4o-mini

# Optional: set for Azure OpenAI or a local LLM proxy.
#   Azure example: https://<your-resource>.openai.azure.com/openai/deployments/<deployment>
# OPENAI_BASE_URL=

# Optional: OpenAI organization id.
# OPENAI_ORGANIZATION=

# Tuning knobs (all optional; defaults shown).
# OPENAI_TEMPERATURE=0.2
# OPENAI_MAX_OUTPUT_TOKENS=4000
# OPENAI_TIMEOUT_SECONDS=60
# OPENAI_MAX_RETRIES=2              # transport-level retries on 5xx / 429
# OPENAI_SCHEMA_RETRY_ATTEMPTS=1    # extra attempts if LLM JSON fails Pydantic validation

# Force mock mode even if OPENAI_API_KEY is set (useful for demos / CI).
FORCE_MOCK=false

# --- Postgres ---
POSTGRES_USER=sdlc
POSTGRES_PASSWORD=sdlc
POSTGRES_DB=sdlc_copilot

# --- .NET API ---
ASPNETCORE_ENVIRONMENT=Development
