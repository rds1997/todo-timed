# ---------------------------------------------------------------------------
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.
# ---------------------------------------------------------------------------

# --- OpenAI / AI service ---

# Leave empty to run in deterministic mock mode (demo-able end-to-end without a key).
OPENAI_API_KEY=

# Any OpenAI chat model that supports response_format={"type":"json_object"}.
# Tested with: gpt-4o-mini (default), gpt-4o, gpt-4-turbo.
OPENAI_MODEL=gpt-4o-mini

# Azure OpenAI or local LLM proxy — leave commented out for standard api.openai.com.
# IMPORTANT: do not set this to an empty string; omit it entirely when unused.
# An empty OPENAI_BASE_URL causes httpx.UnsupportedProtocol at request time.
#   Azure example: https://<resource>.openai.azure.com/openai/deployments/<deployment>
# OPENAI_BASE_URL=

# Optional OpenAI organisation id.  Omit when unused (empty string causes SDK warnings).
# OPENAI_ORGANIZATION=

# --- Tuning knobs (all optional; defaults shown) ---
# OPENAI_TEMPERATURE=0.2
# OPENAI_MAX_OUTPUT_TOKENS=4000
# OPENAI_TIMEOUT_SECONDS=60
# OPENAI_MAX_RETRIES=2              # transport-level retries on 5xx / 429
# OPENAI_SCHEMA_RETRY_ATTEMPTS=1    # extra attempts if LLM JSON fails Pydantic validation

# Conversation memory: max prior chat turns the LLM sees per request.
# The .NET backend persists full history in Postgres; this only caps the prompt window.
# CHAT_HISTORY_WINDOW=20

# Force mock mode even if OPENAI_API_KEY is set (useful for demos / CI / cost control).
FORCE_MOCK=false

# Service log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Postgres ---
POSTGRES_USER=sdlc
POSTGRES_PASSWORD=sdlc
POSTGRES_DB=sdlc_copilot

# --- .NET API ---
ASPNETCORE_ENVIRONMENT=Development
